@page "/progressions"
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject AppState State
@inject ChordPlayer Player
@inject IJSRuntime JS

<TopNav Title="@L["Nav_Progressions"]" />

<div class="settings-card page-card">
    <KeySelector Changed="KeyChanged" />
    <SettingRow Label="@L["Key_Sevenths"]">
        <Toggle Value="State.KeySevenths" ValueChanged="SeventhsChanged" />
    </SettingRow>
    <SettingRow Label="@L["Prog_Smooth"]">
        <Toggle Value="State.SmoothTransitions" ValueChanged="SmoothChanged" />
    </SettingRow>
    @* Shared with the metronome page; a chord lasts one of its bars. *@
    <SettingRow Label="@L["Prog_Tempo"]">
        <div class="tuner-stepper">
            <button type="button" @onclick="() => SetBpm(State.Settings.MetronomeBpm - TempoStep)" disabled="@(State.Settings.MetronomeBpm <= Metronome.MinBpm)">−</button>
            <span>♩ = @State.Settings.MetronomeBpm</span>
            <button type="button" @onclick="() => SetBpm(State.Settings.MetronomeBpm + TempoStep)" disabled="@(State.Settings.MetronomeBpm >= Metronome.MaxBpm)">+</button>
        </div>
    </SettingRow>
    <SettingRow Label="@L["Nav_Metronome"]">
        <Toggle Value="State.Settings.ProgressionClick" ValueChanged="ClickChanged" />
    </SettingRow>
</div>
<button type="button" class="btn btn-primary btn-lg btn-block page-action" @onclick="Generate">🎲 @L["Prog_Generate"]</button>

@if (State.Settings.ShowTips && !tipClosed)
{
    <div class="alert alert-info progression-tip">
        <button type="button" class="close" @onclick="() => tipClosed = true">&times;</button>
        @L["Prog_Hint"]
    </div>
}

<TuningBadge />
<div class="list-group progression-list">
    @foreach (var item in items)
    {
        var current = item;
        <div class="list-group-item @(selected == current ? "active-progression" : null)">
            <div class="progression-head" @onclick="() => Select(current)">
                <span class="label label-default">@current.Label</span>
                <span class="progression-numerals">@string.Join(" – ", current.Chords.Select(i => i.Numeral))</span>
                <button type="button" class="btn btn-sm pull-right @(playing == current ? "btn-danger" : "btn-default")" data-audio-unlock
                        @onclick="() => Play(current)" @onclick:stopPropagation="true">@(playing == current ? "■" : "▶\uFE0E")</button>
            </div>
            <div class="progression-symbols" @onclick="() => Select(current)">
                @for (var i = 0; i < current.Chords.Length; i++)
                {
                    <span class="@(playing == current && playingChord == i ? "progression-playing" : null)">@Symbol(current.Chords[i].Chord)</span>
                }
            </div>
            @if (selected == current)
            {
                @if (current.Layouts == null)
                {
                    <div class="progression-loading text-muted">…</div>
                }
                else
                {
                    <div class="progression-diagrams">
                        @for (var i = 0; i < current.Chords.Length; i++)
                        {
                            var index = i;
                            var chord = current.Chords[i].Chord;
                            var layouts = current.Layouts[i];
                            <div class="progression-chord @(playing == current && playingChord == index ? "progression-playing" : null)">
                                <a href="@ChordPage.Url(chord, true)">@Symbol(chord)</a>
                                @if (State.Settings.Capo > 0)
                                {
                                    <div class="capo-shape-short">@L["Capo_ShapeShort", Symbol(chord.Transpose(-State.Settings.Capo))]</div>
                                }
                                @* Tones outside the scale show where the melody material changes (a borrowed ♭VII, the leading tone of V in minor). *@
                                <div class="progression-notes">
                                    @foreach (var note in chord.NotesFromBass)
                                    {
                                        <span class="@(InScale(note) ? null : "out-of-scale")">@note.ToString(conv)</span>
                                    }
                                </div>
                                @if (layouts.Length == 0)
                                {
                                    <div class="text-muted">–</div>
                                }
                                else
                                {
                                    <ChordLayoutView Layout="layouts[current.Chosen[index]]" Chord="chord" />
                                    @if (layouts.Length > 1)
                                    {
                                        <div class="progression-pick">
                                            <button type="button" class="btn btn-default btn-xs" @onclick="() => Pick(current, index, -1)">‹</button>
                                            @if (current.Locked[index] != null)
                                            {
                                                @* A fingering picked by hand stays; the others follow it. Tapping the pin lets it follow again. *@
                                                <span class="progression-locked" @onclick="() => Unlock(current, index)">📌 @(current.Chosen[index] + 1)/@layouts.Length</span>
                                            }
                                            else
                                            {
                                                <span>@(current.Chosen[index] + 1)/@layouts.Length</span>
                                            }
                                            <button type="button" class="btn btn-default btn-xs" @onclick="() => Pick(current, index, 1)">›</button>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

<RelatedLinks Pages="[AppPages.Key, AppPages.Circle, AppPages.Metronome]" />

@code {
    private const int GeneratedLength = 4;
    /// <summary>Change of the tempo with one tap of − or + (the metronome page sets it exactly).</summary>
    private const int TempoStep = 5;

    /// <summary>A progression in the chosen key with the fingerings found for its chords.</summary>
    private class Item
    {
        public string Label { get; init; }
        public DegreeChord[] Chords { get; init; }
        /// <summary>Fingerings of each chord, found when the progression is first opened or played.</summary>
        public GuitarChordLayoutDecorator[][] Layouts { get; set; }
        /// <summary>Index of the fingering chosen for each chord.</summary>
        public int[] Chosen { get; set; }
        /// <summary>Fingerings picked by hand, kept when the others are chosen for smooth transitions.</summary>
        public int?[] Locked { get; set; }
    }

    private static readonly Random Random = new();
    private NamingConvention conv;
    private List<Item> items = [];
    private Item generated;
    private Item selected;
    private bool tipClosed;
    /// <summary>Progression playing to the metronome (null = none) and its chord sounding (-1 while counting in).</summary>
    private Item playing;
    private int playingChord = -1;
    /// <summary>Bars counted in before the progression playing starts.</summary>
    private int playingCountIn;
    private DotNetObjectReference<Progressions> self;

    private Key Current => new(State.KeyTonic, State.KeyScale);

    protected override void OnInitialized()
    {
        conv = State.Settings.conv;
        self = DotNetObjectReference.Create(this);
        Build();
    }

    private void KeyChanged()
    {
        generated = null;
        Build();
    }

    private void SmoothChanged(bool value)
    {
        State.SmoothTransitions = value;
        foreach (var item in items.Where(i => i.Layouts != null))
        {
            Choose(item);
        }
    }

    private void SeventhsChanged(bool value)
    {
        State.KeySevenths = value;
        generated = null;
        Build();
    }

    /// <summary>Common progressions written for the kind of key chosen (major or minor tonic chord, or its own scale).</summary>
    private void Build()
    {
        var key = Current;

        // The progression playing is gone from the list.
        _ = StopPlaying();
        selected = null;
        items = Progression.Common
            .Where(i => i.Fits(key))
            .Select(i => new Item { Label = L[$"Style_{i.Style}"], Chords = i.In(key, State.KeySevenths) })
            .ToList();
        if (generated != null)
        {
            items.Insert(0, generated);
        }
    }

    private async Task Generate()
    {
        generated = new Item
        {
            Label = "🎲",
            Chords = Progression.Generate(Current, GeneratedLength, State.KeySevenths, Random)
        };
        Build();
        await Select(generated);
    }

    /// <summary>Whether the note belongs to the scale shown for the key (enharmonics are equal).</summary>
    private bool InScale(Note note) => Current.Scale.Notes.Any(i => Note.Normalize(i) == Note.Normalize(note));

    private string Symbol(Chord chord) => new ChordDecorator(chord, conv).Symbols[0];

    private async Task Select(Item item)
    {
        selected = selected == item ? null : item;
        if (selected != null)
        {
            await EnsureLayouts(item);
        }
    }

    /// <summary>Finds the fingerings of the progression's chords and chooses one of each (see <see cref="Choose"/>).</summary>
    private async Task EnsureLayouts(Item item)
    {
        if (item.Layouts != null)
        {
            return;
        }
        var s = State.Settings;
        var layouts = await Task.Run(() =>
        {
            // A chord repeated in the progression (as in a blues) is fingered only once.
            var found = item.Chords
                .Select(i => i.Chord)
                .Distinct()
                .ToDictionary(c => c, c => new ChordDecorator(c, conv)
                    .GenerateLayouts(s.InstrumentInfo, s.AllowBarre, s.AllowSpecial, true, s.maxFret, s.EasyOnly)
                    .OrderBy(l => l.Favorite ? 0 : 1)
                    .ToArray());

            return item.Chords.Select(i => found[i.Chord]).ToArray();
        });

        item.Locked = new int?[layouts.Length];
        item.Layouts = layouts;
        Choose(item);
    }

    /// <summary>
    /// With smooth transitions, fingerings close to each other on the neck around those picked by hand;
    /// otherwise the easiest (or favourite) fingering of each chord.
    /// </summary>
    private void Choose(Item item)
    {
        if (State.SmoothTransitions)
        {
            item.Chosen = VoiceLeading.Choose(
                item.Layouts.Select(l => l.Select(i => i.Layout).ToArray()).ToArray(),
                item.Locked,
                l => Favorites.Contains(l.Chord, l));
        }
        else
        {
            item.Chosen = item.Locked.Select(i => i ?? 0).ToArray();
        }
    }

    private void Pick(Item item, int index, int step)
    {
        var count = item.Layouts[index].Length;

        item.Locked[index] = (item.Chosen[index] + step + count) % count;
        Choose(item);
    }

    private void Unlock(Item item, int index)
    {
        item.Locked[index] = null;
        Choose(item);
    }

    /// <summary>Bars counted in before the first chord when the metronome clicks.</summary>
    private int CountIn => State.Settings.ProgressionClick ? 1 : 0;

    private object Options => new
    {
        bpm = State.Settings.MetronomeBpm,
        beats = State.Settings.MetronomeBeats,
        subdivision = 1,
        accent = State.Settings.MetronomeAccent,
        click = State.Settings.ProgressionClick,
        countIn = playingCountIn,
        notify = true,
    };

    /// <summary>
    /// Plays the progression over and over to the metronome, one chord per bar strummed on every beat; tapping ▶ of
    /// the progression playing stops it.
    /// </summary>
    private async Task Play(Item item)
    {
        if (playing == item)
        {
            await StopPlaying();
            return;
        }
        await EnsureLayouts(item);
        playing = item;
        playingChord = -1;
        playingCountIn = CountIn;
        try
        {
            await JS.InvokeAsync<bool>("metronome.start", self, null, Options);
        }
        catch (JSException)
        {
            playing = null;
        }
    }

    private async Task StopPlaying()
    {
        if (playing == null)
        {
            return;
        }
        playing = null;
        playingChord = -1;
        Player.Damp();
        try
        {
            await JS.InvokeVoidAsync("metronome.stop");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>A beat heard: the chord of its bar is strummed, harder on the first beat.</summary>
    [JSInvokable]
    public void OnMetronomeBeat(int bar, int beat) => InvokeAsync(() =>
    {
        var item = playing;

        if (item?.Layouts == null || bar < playingCountIn)
        {
            return;
        }
        var index = (bar - playingCountIn) % item.Chords.Length;
        var layouts = item.Layouts[index];

        if (layouts.Length > 0)
        {
            var strings = layouts[0].IntPositions.Length;
            // The strum takes at most a quarter of the beat, so it is over well before the next one.
            var spread = (int)Math.Min(30, 60000.0 / State.Settings.MetronomeBpm / 4 / strings);

            // The fingering chosen now: a change of it while playing is heard from the next beat.
            Player.Strum(State.Settings.InstrumentInfo, layouts[item.Chosen[index]].IntPositions, beat == 0, beat == 0 ? 1f : 0.55f, spread);
        }
        else if (beat == 0)
        {
            Player.Damp();
        }
        if (beat == 0 && playingChord != index)
        {
            playingChord = index;
            StateHasChanged();
        }
    });

    /// <summary>The app went to the background, which stops the metronome (js/metronome.js).</summary>
    [JSInvokable]
    public void OnMetronomeStopped() => InvokeAsync(() =>
    {
        playing = null;
        playingChord = -1;
        StateHasChanged();
    });

    private async Task SetBpm(int value)
    {
        State.Settings.MetronomeBpm = Math.Clamp(value, Metronome.MinBpm, Metronome.MaxBpm);
        State.Settings.Save();
        await UpdatePlaying();
    }

    private async Task ClickChanged(bool value)
    {
        State.Settings.ProgressionClick = value;
        State.Settings.Save();
        await UpdatePlaying();
    }

    private async Task UpdatePlaying()
    {
        if (playing != null)
        {
            await JS.InvokeVoidAsync("metronome.update", Options);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await StopPlaying();
        self?.Dispose();
    }
}
