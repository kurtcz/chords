@page "/key"
@inject AppState State
@inject ChordPlayer Player

<TopNav Title="@L["Nav_Key"]" />

<div class="page-segment">
    <Segmented @bind-Value="detect" Off="@L["Key_TabChords"]" On="@L["Key_TabDetect"]" />
</div>

@if (!detect)
{
    <div class="settings-card page-card">
        <KeySelector Changed="StateHasChanged" />
        <SettingRow Label="@L["Key_Sevenths"]">
            <Toggle @bind-Value="State.KeySevenths" />
        </SettingRow>
    </div>
    <table class="table key-chords">
        <tbody>
            @* Stacking thirds in the non-diatonic scales can give a chord with no symbol (B D♭ F in C double harmonic); it is left out. *@
            @foreach (var degree in Current.DiatonicChords(State.KeySevenths).Where(i => Current.Contains(i.Chord)))
            {
                var chord = degree.Chord;
                <tr>
                    <td class="numeral">@degree.Numeral</td>
                    <td><a href="@ChordUrl(chord)">@Symbol(chord)</a></td>
                    <td class="text-right">
                        <button type="button" class="btn btn-default btn-sm" @onclick="() => Player.PlayChord(chord)">▶</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <RelatedLinks Pages="[AppPages.Progressions, AppPages.Circle]"
                  Titles="@(new() { [AppPages.Progressions] = L["Key_Progressions"] })" />
}
else
{
    @if (State.Settings.ShowTips && !tipClosed)
    {
        <div class="alert alert-info">
            <button type="button" class="close" @onclick="() => tipClosed = true">&times;</button>
            @L["Key_DetectHint"]
        </div>
    }
    <div class="settings-card page-card">
        <SettingSelect Label="@L["Pick_Root"]">
            <Value>@addRoot.ToString(conv)</Value>
            <ChildContent>
                @foreach (var note in Tonics)
                {
                    <li><a @onclick="() => addRoot = note">@note.ToString(conv)</a></li>
                }
            </ChildContent>
        </SettingSelect>
        <SettingSelect Label="@L["Pick_ChordType"]">
            <Value>@TypeName(addType)</Value>
            <ChildContent>
                @foreach (var type in DetectTypes)
                {
                    <li><a @onclick="() => addType = type">@TypeName(type)</a></li>
                }
            </ChildContent>
        </SettingSelect>
    </div>
    <button type="button" class="btn btn-primary btn-lg btn-block page-action" @onclick="Add">@L["Key_Add"]</button>

    <div class="key-entered">
        @for (var i = 0; i < State.KeyDetectChords.Count; i++)
        {
            var index = i;
            <span class="label label-primary key-chip" @onclick="() => Remove(index)">@Symbol(State.KeyDetectChords[i]) &times;</span>
        }
        @if (State.KeyDetectChords.Count > 0)
        {
            <button type="button" class="btn btn-link" @onclick="Clear">@L["Shape_Clear"]</button>
        }
    </div>

    @if (State.KeyDetectChords.Count == 0)
    {
        <h4 class="text-muted">@L["Key_NoChords"]</h4>
    }
    else if (matches.Length == 0)
    {
        <h4 class="text-muted">@L["Key_NoKey"]</h4>
    }
    else
    {
        <div class="list-group">
            @foreach (var match in matches)
            {
                <a class="list-group-item" @onclick="() => Show(match.Key)">
                    <span class="badge">@match.Fitting/@match.Total</span>
                    <h4 class="list-group-item-heading">@KeyName(match.Key)</h4>
                    <p class="list-group-item-text">@string.Join("  ", match.Numerals.Select(i => i ?? "–"))</p>
                </a>
            }
        </div>
    }
}

@code {
    private const int MaxMatches = 6;
    private static readonly Note[] Tonics = new FindChordModel().Notes;
    private static readonly ChordType[] DetectTypes =
    [
        ChordType.Major, ChordType.Minor, ChordType.DominantSeventh, ChordType.MajorSeventh, ChordType.MinorSeventh,
        ChordType.Diminished, ChordType.MinorSeventhFlat5, ChordType.DiminishedSeventh, ChordType.Augmented,
        ChordType.Sus2, ChordType.Sus4, ChordType.Sixth, ChordType.MinorSixth, ChordType.Add9, ChordType.Ninth, ChordType.Fifth
    ];

    private NamingConvention conv;
    private bool detect;
    private bool tipClosed;
    private Note addRoot = new(Tone.C);
    private ChordType addType = ChordType.Major;
    private KeyMatch[] matches = [];

    /// <summary>"chords" opens the chords of the key even when chords to detect a key from were entered.</summary>
    [SupplyParameterFromQuery] public string Tab { get; set; }

    private Key Current => new(State.KeyTonic, State.KeyScale);

    protected override void OnInitialized()
    {
        conv = State.Settings.conv;
        detect = Tab != "chords" && State.KeyDetectChords.Count > 0;
        Detect();
    }

    private string Symbol(Chord chord) => new ChordDecorator(chord, conv).Symbols[0];

    private string KeyName(Key key) => $"{key.Tonic.ToString(conv)} {L[$"Scale_{key.ScaleType}"]}";

    private string TypeName(ChordType type) => type == ChordType.Major ? L["ChordType_Major"] : type.ToDescription();

    private static string ChordUrl(Chord chord) => ChordPage.Url(chord.Root, chord.ChordType.ToDescription(), true);

    private void Add()
    {
        State.KeyDetectChords.Add(new Chord(addRoot, addType));
        Detect();
    }

    private void Remove(int index)
    {
        State.KeyDetectChords.RemoveAt(index);
        Detect();
    }

    private void Clear()
    {
        State.KeyDetectChords.Clear();
        Detect();
    }

    /// <summary>The best keys; ones with more than one chord outside them less are left out.</summary>
    private void Detect()
    {
        var found = KeyMatch.Find(State.KeyDetectChords);

        matches = found.Where(i => i.Fitting >= found[0].Fitting - 1).Take(MaxMatches).ToArray();
    }

    private void Show(Key key)
    {
        State.KeyTonic = key.Tonic;
        State.KeyScale = key.ScaleType;
        detect = false;
    }
}
