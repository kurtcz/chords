@page "/settings"
@inject AppState State

<TopNav Title="@L["Nav_Settings"]" />

@* Two columns side by side on a wide screen: the general settings, the diagrams and chords. *@
<div class="settings-columns">
<div class="settings-column">
<section class="settings-section">
    <h2>@L["Settings_General"]</h2>
    <div class="settings-card">
        <SettingSelect Label="@L["Settings_Language"]">
            <Value>@LanguageName(settings.Language)</Value>
            <ChildContent>
                <li><a @onclick="() => SetLanguage(null)">@LanguageName(null)</a></li>
                @foreach (var (code, name, flag) in Localizer.Languages)
                {
                    <li><a @onclick="() => SetLanguage(code)">@flag @name</a></li>
                }
            </ChildContent>
        </SettingSelect>
        <SettingSelect Label="@L["Settings_Instrument"]">
            <Value><Icon Name="@InstrumentIcon(settings.Instrument)" Size="22" Class="instrument-icon" />@L[$"Instrument_{settings.Instrument}"]</Value>
            <ChildContent>
                @foreach (var instrument in Enum.GetValues<Instrument>())
                {
                    <li><a @onclick="() => Update(() => { settings.Instrument = instrument; editing = null; })"><Icon Name="@InstrumentIcon(instrument)" Size="22" Class="instrument-icon" />@L[$"Instrument_{instrument}"] <sub>(@Localizer.TuningNotes(settings.TuningOf(instrument), settings.conv))</sub></a></li>
                }
            </ChildContent>
        </SettingSelect>
        @* Tuning of the chosen instrument: the usual ones, the player's own, or a new one. *@
        <SettingSelect Label="@L["Settings_Tuning"]">
            <Value>@L.TuningName(tuning) <sub>(@Localizer.TuningNotes(tuning, settings.conv))</sub></Value>
            <ChildContent>
                @foreach (var t in settings.TuningsFor(settings.Instrument))
                {
                    <li><a @onclick="() => Update(() => { settings.SelectTuning(settings.Instrument, t.Pitches); editing = null; })">@L.TuningName(t) <sub>(@Localizer.TuningNotes(t, settings.conv))</sub></a></li>
                }
                <li><a @onclick="() => editing = new InstrumentTuning(null, settings.Instrument, tuning.Pitches)">+ @L["Tuning_New"]</a></li>
            </ChildContent>
        </SettingSelect>
        @if (editing != null)
        {
            <div class="setting-row">
                <TuningEditor @key="editing" Instrument="settings.Instrument" Initial="editing" Conv="settings.conv"
                              OnSave="SaveTuning" OnCancel="() => editing = null" />
            </div>
        }
        else if (IsSaved(tuning))
        {
            <div class="setting-row tuning-actions">
                <button type="button" class="btn btn-default" @onclick="() => editing = tuning">@L["Tuning_Edit"]</button>
                <button type="button" class="btn btn-default tuning-delete" @onclick="() => DeleteTuning(tuning)">@L["Tuning_Delete"]</button>
            </div>
        }
        @* Capo of the chosen instrument: diagrams then show the shapes to hold, counted from the capo. *@
        <SettingSelect Label="@L["Settings_Capo"]">
            <Value>@CapoName(settings.Capo)</Value>
            <ChildContent>
                @for (var fret = 0; fret <= InstrumentInfo.MaxCapo; fret++)
                {
                    var f = fret;
                    <li><a @onclick="() => Update(() => settings.Capo = f)">@CapoName(f)</a></li>
                }
            </ChildContent>
        </SettingSelect>
        <SettingSelect Label="@L["Settings_Notation"]">
            <Value>@string.Join(" ", settings.Notes.Select(i => i.ToString(settings.conv)))</Value>
            <ChildContent>
                @foreach (var conv in settings.NamingConventions)
                {
                    <li><a @onclick="() => Update(() => settings.conv = conv)">@L[$"Notation_{conv}"] <sub>(@string.Join("-", settings.Notes.Select(i => i.ToString(conv))))</sub></a></li>
                }
            </ChildContent>
        </SettingSelect>
        <SettingSelect Label="@L["Settings_Theme"]">
            <Value>@L[$"Theme_{settings.Theme}"]</Value>
            <ChildContent>
                @foreach (var theme in Enum.GetValues<ThemeMode>())
                {
                    <li><a @onclick="() => Update(() => { settings.Theme = theme; State.ApplyTheme(); })">@L[$"Theme_{theme}"]</a></li>
                }
            </ChildContent>
        </SettingSelect>
        <SettingRow Label="@L["Settings_ShowTips"]">
            <Toggle Value="settings.ShowTips" ValueChanged="v => Update(() => settings.ShowTips = v)" />
        </SettingRow>
    </div>
</section>
</div>

<div class="settings-column">
<section class="settings-section">
    <h2>@L["Settings_Diagrams"]</h2>
    <div class="settings-card">
        <div class="setting-row">
            <Segmented Value="settings.Horizontal" ValueChanged="v => Update(() => settings.Horizontal = v)"
                       Off="@L["Settings_Vertical"]" On="@L["Settings_Horizontal"]" />
        </div>
        @* Mirroring only matters when the neck runs sideways. *@
        @if (settings.Horizontal)
        {
            <SettingRow Label="@L["Settings_LeftHanded"]">
                <Toggle Value="settings.LeftHanded" ValueChanged="v => Update(() => settings.LeftHanded = v)" />
            </SettingRow>
        }
    </div>
</section>

<section class="settings-section">
    <h2>@L["Settings_Chords"]</h2>
    <div class="settings-card">
        <div class="setting-row">
            <Segmented Value="!settings.ShowBasicChordTypes" ValueChanged="v => Update(() => settings.ShowBasicChordTypes = !v)"
                       Off="@L["Settings_BasicChords"]" On="@L["Settings_AllChords"]" />
        </div>
        <SettingRow Label="@(L["Settings_MaxFret"].TrimEnd(':', '：', ' '))">
            <ChildContent><span class="setting-number">@maxFret</span></ChildContent>
            <Below>
                <input type="range" min="1" max="15" step="1" value="@maxFret"
                       @oninput="e => maxFret = int.Parse((string)e.Value!)"
                       @onchange="e => Update(() => settings.maxFret = int.Parse((string)e.Value!))" />
            </Below>
        </SettingRow>
        <SettingRow Label="@L["Settings_EasyOnly"]">
            <Toggle Value="settings.EasyOnly" ValueChanged="v => Update(() => settings.EasyOnly = v)" />
        </SettingRow>
        @* Barre and special shapes only exist in the guitar fingering rules. *@
        @if (settings.Instrument == Instrument.Guitar)
        {
            <SettingRow Label="@L["Settings_AllowBarre"]">
                <Toggle Value="settings.AllowBarre" ValueChanged="v => Update(() => settings.AllowBarre = v)" />
            </SettingRow>
            <SettingRow Label="@L["Settings_AllowSpecial"]">
                <Toggle Value="settings.AllowSpecial" ValueChanged="v => Update(() => settings.AllowSpecial = v)" />
            </SettingRow>
        }
    </div>
</section>
</div>
</div>

@code {
    private SettingsModel settings;
    private int maxFret;

    protected override void OnInitialized()
    {
        settings = State.Settings;
        maxFret = settings.maxFret;
    }

    /// <summary>Name of a language in that language; null is the device language.</summary>
    private string LanguageName(string code)
    {
        if (string.IsNullOrEmpty(code))
        {
            return L["Settings_SystemLanguage", LanguageName(Localizer.SystemLanguage)];
        }
        var language = Localizer.Languages.FirstOrDefault(i => i.Code == code);

        return language.Name == null ? code : $"{language.Flag} {language.Name}";
    }

    private string CapoName(int fret) => fret == 0 ? L["Capo_None"] : L["Capo_Fret", fret];

    /// <summary>Name of the instrument's drawing in <see cref="Icon"/>.</summary>
    private static string InstrumentIcon(Instrument instrument) => instrument.ToString().ToLowerInvariant();

    private InstrumentTuning tuning => settings.TuningOf(settings.Instrument);
    /// <summary>Tuning open in the editor: a saved one being changed, or a new one; null when closed.</summary>
    private InstrumentTuning editing;

    private bool IsSaved(InstrumentTuning t) => settings.CustomTunings.Contains(t);

    /// <summary>
    /// Saves the edited tuning in place of the one it started from and chooses it.
    /// Pitches of a preset just choose the preset; a saved tuning of the same pitches is replaced.
    /// </summary>
    private void SaveTuning(InstrumentTuning saved) => Update(() =>
    {
        var instrument = settings.Instrument;

        settings.CustomTunings.Remove(editing);
        if (InstrumentTuning.FindPreset(instrument, saved.Pitches) == null)
        {
            settings.CustomTunings.RemoveAll(i => i.Instrument == instrument && InstrumentTuning.SamePitches(i.Pitches, saved.Pitches));
            settings.CustomTunings.Add(saved);
        }
        settings.SelectTuning(instrument, saved.Pitches);
        editing = null;
    });

    private void DeleteTuning(InstrumentTuning t) => Update(() =>
    {
        settings.CustomTunings.Remove(t);
        settings.SelectTuning(t.Instrument, null);
    });

    private void SetLanguage(string code) => Update(() =>
    {
        settings.Language = code;
        L.SetLanguage(code);
        // Switch to the note names musicians of that language use; the notation can still be changed below.
        settings.conv = Localizer.DefaultNotation(Localizer.CurrentLanguage);
    });

    private void Update(Action change)
    {
        change();
        maxFret = settings.maxFret;
        settings.Save();
    }
}
