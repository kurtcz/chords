@page "/tuner"
@using System.Globalization
@using Chords.Core.Tuning
@implements IDisposable
@inject AppState State
@inject TunerListener Listener
@inject ChordPlayer Player

<TopNav Title="@L["Nav_Tuner"]" />

@if (status == TunerStatus.Denied)
{
    <div class="alert alert-warning">
        <p>@L["Tuner_MicDenied"]</p>
        <button type="button" class="btn btn-default" @onclick="() => AppInfo.ShowSettingsUI()">@L["Tuner_OpenSettings"]</button>
    </div>
}
else if (status == TunerStatus.Failed)
{
    <div class="alert alert-danger">@L["Tuner_MicError"]</div>
}

<div class="tuner-display @StateClass">
    <div class="tuner-note">
        @if (reading == null)
        {
            <span>–</span>
        }
        else
        {
            @NoteLetter(reading.Target, reading.String)<sub>@TunerMath.OctaveOf(reading.Target)</sub>
        }
    </div>
    <svg class="tuner-gauge" viewBox="0 -12 300 186" xmlns="http://www.w3.org/2000/svg">
        @foreach (var (from, to, zone) in Zones)
        {
            if (from == 0)
            {
                <path class="@zone" d="@Arc(-to + ZoneGap, to - ZoneGap)" />
            }
            else
            {
                <path class="@zone" d="@Arc(-to, -from - ZoneGap)" />
                <path class="@zone" d="@Arc(from + ZoneGap, to)" />
            }
        }
        @for (var c = -50; c <= 50; c += 5)
        {
            var major = c % 25 == 0;
            var (x1, y1) = Point(c, R - (major ? 24 : 17));
            var (x2, y2) = Point(c, R - 9);
            <line class="@(c == 0 ? "tick center" : major ? "tick major" : "tick")" x1="@F(x1)" y1="@F(y1)" x2="@F(x2)" y2="@F(y2)" />
        }
        <text class="tuner-label" x="@F(Point(-50, R - 35).X)" y="@F(Point(-50, R - 35).Y + 4)">−50</text>
        <text class="tuner-label" x="@F(Point(-25, R - 35).X)" y="@F(Point(-25, R - 35).Y + 4)">−25</text>
        <text class="tuner-label" x="@F(Point(25, R - 35).X)" y="@F(Point(25, R - 35).Y + 4)">+25</text>
        <text class="tuner-label" x="@F(Point(50, R - 35).X)" y="@F(Point(50, R - 35).Y + 4)">+50</text>
        <text class="tuner-accidental" x="@F(Point(-62, R - 4).X - 4)" y="@F(Point(-62, R - 4).Y + 16)">♭</text>
        <text class="tuner-accidental" x="@F(Point(62, R - 4).X + 4)" y="@F(Point(62, R - 4).Y + 16)">♯</text>
        @if (reading != null)
        {
            <g class="tuner-needle" style="transform: rotate(@F(NeedleAngle)deg)">
                <path d="M @F(Cx - 4) @F(Cy) L @F(Cx - 1) @F(Cy - R + 6) Q @F(Cx) @F(Cy - R + 3) @F(Cx + 1) @F(Cy - R + 6) L @F(Cx + 4) @F(Cy) Z" />
            </g>
        }
        <circle class="tuner-hub" cx="@F(Cx)" cy="@F(Cy)" r="10" />
        <circle cx="@F(Cx)" cy="@F(Cy)" r="3.5" fill="#fff" />
    </svg>
    <div class="tuner-readout">
        @if (reading != null)
        {
            <span class="tuner-cents">@reading.Cents.ToString("+0;−0;0", CultureInfo.InvariantCulture)¢</span>
            <span class="tuner-hz">@reading.Frequency.ToString("0.0", CultureInfo.CurrentCulture) Hz</span>
            @if ((int)Math.Round(reading.Pitch) != reading.Target)
            {
                <span class="tuner-hz">♪ @NoteName((int)Math.Round(reading.Pitch))</span>
            }
        }
    </div>
    @if (Direction is { } direction)
    {
        <div class="tuner-direction @direction.Css">@direction.Text</div>
    }
</div>

<div class="tuner-mode" role="group">
    <button type="button" class="@(chromatic ? null : "active")" aria-pressed="@(!chromatic)" @onclick="() => SetChromatic(false)">
        @L[$"Instrument_{State.Settings.Instrument}"]
    </button>
    <button type="button" class="@(chromatic ? "active" : null)" aria-pressed="@chromatic" @onclick="() => SetChromatic(true)">
        @L["Tuner_Chromatic"]
    </button>
</div>

@if (!chromatic)
{
    @* Quick switch between the tunings of the instrument; the strings below follow it. *@
    <div class="tuner-tuning">
        <select aria-label="@L["Tuning_Custom"]" @onchange="e => SetTuning((string)e.Value)">
            @{ var i = 0; }
            @foreach (var t in tunings)
            {
                <option value="@i" selected="@(InstrumentTuning.SamePitches(t.Pitches, instrument.Pitches))">@L.TuningName(t) (@Localizer.TuningNotes(t, conv, " "))</option>
                i++;
            }
        </select>
    </div>
    <div class="tuner-strings">
        <button type="button" class="tuner-auto @(lockedString < 0 ? "active" : null)" @onclick="() => Lock(-1)">
            @L["Tuner_Auto"]
        </button>
        @* The strings stay on one line; when Auto does not fit beside them, it goes on a line of its own. *@
        <div class="tuner-string-row">
            @for (var s = 0; s < instrument.StringCount; s++)
            {
                var str = s;
                var css = (lockedString == s ? "locked " : "") + (reading?.String == s ? "heard " : "") + (tunedStrings.Contains(s) ? "done" : "");
                var offset = tuning.Offset(s);
                @* A string tuned away from the standard tuning shows by how many half steps, so it is retuned first. *@
                <button type="button" class="tuner-string @css @(offset != 0 ? "retuned" : null)" title="@NoteName(instrument.Pitches[s], s)" @onclick="() => Lock(str)">
                    @NoteLetter(instrument.Pitches[s], s)
                    @if (offset != 0)
                    {
                        <span class="tuner-offset">@offset.ToString("+0;−0")</span>
                    }
                </button>
            }
        </div>
    </div>
}

<div class="tuner-a4">
    <div class="tuner-stepper">
        <button type="button" @onclick="() => SetA4(a4 - 1)" disabled="@(a4 <= MinA4)">−</button>
        <span>@TunerMath.NoteOf(69).ToString(conv)4 = @a4 Hz</span>
        <button type="button" @onclick="() => SetA4(a4 + 1)" disabled="@(a4 >= MaxA4)">+</button>
    </div>
</div>

@if (State.Settings.ShowTips && !tipClosed && !chromatic)
{
    <div class="alert alert-info tuner-tip">
        <button type="button" class="close" @onclick="() => tipClosed = true">&times;</button>
        @L["Tuner_Hint"]
    </div>
}

@code {
    private const int MinA4 = 430;
    private const int MaxA4 = 450;
    /// <summary>Green zone of the gauge.</summary>
    private const double InTuneCents = 5;
    /// <summary>The string counts as tuned when it stays this close for <see cref="SettleTime"/>.</summary>
    private const double TunedCents = 3;
    private static readonly TimeSpan SettleTime = TimeSpan.FromSeconds(0.8);
    /// <summary>Redraws per second at most.</summary>
    private const int FrameRate = 15;
    private const double Cx = 150, Cy = 160;
    /// <summary>Radius of the coloured scale.</summary>
    private const double R = 130;
    /// <summary>Cents left blank between two zones of the scale.</summary>
    private const double ZoneGap = 0.6;
    /// <summary>Zones of the scale, mirrored around 0 cents: from, to (cents) and CSS class.</summary>
    private static readonly (double From, double To, string Css)[] Zones =
    {
        (0, InTuneCents, "zone in-tune"),
        (InTuneCents, 12, "zone near"),
        (12, 25, "zone off"),
        (25, 55, "zone far"),
    };
    /// <summary>Degrees the needle turns per cent (±50 cents = ±60°).</summary>
    private const double DegreesPerCent = 1.2;

    private InstrumentInfo instrument;
    private InstrumentTuning tuning;
    private InstrumentTuning[] tunings = [];
    private NamingConvention conv;
    private int a4;
    private int lockedString = -1;
    /// <summary>Tunes to the nearest semitone instead of the strings of the instrument.</summary>
    private bool chromatic;
    private TunerStatus status;
    private TunerReading reading;
    private volatile TunerReading latest;
    private volatile bool dirty;
    private DateTime? inTuneSince;
    private bool tuned;
    /// <summary>Strings tuned since the page was opened.</summary>
    private readonly HashSet<int> tunedStrings = new();
    private bool tipClosed;
    private Timer timer;
    private Window window;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        instrument = State.Settings.InstrumentInfo;
        tuning = State.Settings.TuningOf(State.Settings.Instrument);
        tunings = State.Settings.TuningsFor(State.Settings.Instrument).ToArray();
        if (!tunings.Any(t => InstrumentTuning.SamePitches(t.Pitches, tuning.Pitches)))
        {
            tunings = [tuning, .. tunings];
        }
        conv = State.Settings.conv;
        a4 = Math.Clamp(State.Settings.TunerA4, MinA4, MaxA4);
        chromatic = State.Settings.TunerChromatic;
        Listener.ReadingChanged += OnReading;
        timer = new Timer(_ => Redraw(), null, 1000 / FrameRate, 1000 / FrameRate);
        window = Application.Current?.Windows.FirstOrDefault();
        if (window != null)
        {
            // Release the microphone while the app is in the background.
            window.Stopped += OnAppStopped;
            window.Resumed += OnAppResumed;
        }
        await StartAsync();
    }

    private async Task StartAsync()
    {
        status = await Listener.StartAsync(instrument, a4, lockedString, chromatic);
        if (disposed)
        {
            Listener.Stop();
        }
    }

    private void OnAppStopped(object sender, EventArgs e) => Listener.Stop();

    private void OnAppResumed(object sender, EventArgs e) => InvokeAsync(async () =>
    {
        if (!disposed)
        {
            // Also picks up a microphone permission granted in the system settings meanwhile.
            await StartAsync();
            StateHasChanged();
        }
    });

    private void OnReading(TunerReading value)
    {
        latest = value;
        dirty = true;
    }

    private void Redraw()
    {
        if (!dirty)
        {
            return;
        }
        dirty = false;
        InvokeAsync(() =>
        {
            reading = latest;
            UpdateTuned();
            StateHasChanged();
        });
    }

    private void UpdateTuned()
    {
        if (reading == null)
        {
            // The last string tuned stays ticked until the next note.
            inTuneSince = null;
            return;
        }
        if (Math.Abs(reading.Cents) <= TunedCents)
        {
            inTuneSince ??= DateTime.UtcNow;
            tuned = DateTime.UtcNow - inTuneSince >= SettleTime;
            if (tuned && reading.String >= 0)
            {
                tunedStrings.Add(reading.String);
            }
        }
        else
        {
            inTuneSince = null;
            tuned = false;
        }
    }

    private void Lock(int s)
    {
        lockedString = s;
        if (s >= 0)
        {
            Player.PlayPitch(instrument.Pitches[s]);
        }
        Listener.Configure(instrument, a4, lockedString, chromatic);
    }

    private void SetChromatic(bool value)
    {
        if (chromatic == value)
        {
            return;
        }
        chromatic = value;
        reading = null;
        inTuneSince = null;
        tuned = false;
        State.Settings.TunerChromatic = chromatic;
        State.Settings.Save();
        Listener.Configure(instrument, a4, lockedString, chromatic);
    }

    private void SetTuning(string index)
    {
        if (!int.TryParse(index, out var i) || i < 0 || i >= tunings.Length)
        {
            return;
        }
        State.Settings.SelectTuning(State.Settings.Instrument, tunings[i].Pitches);
        State.Settings.Save();
        instrument = State.Settings.InstrumentInfo;
        tuning = State.Settings.TuningOf(State.Settings.Instrument);
        // The strings now have other targets.
        tunedStrings.Clear();
        reading = null;
        inTuneSince = null;
        tuned = false;
        Listener.Configure(instrument, a4, lockedString, chromatic);
    }

    private void SetA4(int value)
    {
        a4 = Math.Clamp(value, MinA4, MaxA4);
        // Strings tuned to the old reference pitch are no longer in tune.
        tunedStrings.Clear();
        State.Settings.TunerA4 = a4;
        State.Settings.Save();
        Listener.Configure(instrument, a4, lockedString, chromatic);
    }

    private string NoteName(int pitch, int s = -1) => NoteLetter(pitch, s) + TunerMath.OctaveOf(pitch);

    /// <summary>Name of a pitch; an open string's spelled like its tuning (E♭ in the half-step-down tuning).</summary>
    private string NoteLetter(int pitch, int s = -1)
        => (s >= 0 && s < tuning.Pitches.Length && tuning.Pitches[s] == pitch ? tuning.NoteOf(s) : TunerMath.NoteOf(pitch)).ToString(conv);

    private string StateClass => reading == null ? "silent"
        : tuned ? "tuned"
        : Math.Abs(reading.Cents) <= InTuneCents ? "near"
        : null;

    /// <summary>CSS class and text of the hint below the gauge; null when there is none.</summary>
    private (string Css, string Text)? Direction => reading == null
            ? tuned ? ("ok", "✓ " + L["Tuner_InTune"])
            : status == TunerStatus.Listening ? ("idle", L[chromatic ? "Tuner_ListeningNote" : "Tuner_Listening"])
            : null
        : tuned || Math.Abs(reading.Cents) <= InTuneCents ? ("ok", "✓ " + L["Tuner_InTune"])
        : reading.Cents < 0 ? ("up", "↑ " + L["Tuner_TuneUp"])
        : ("down", "↓ " + L["Tuner_TuneDown"]);

    /// <summary>Needle angle; beyond ±50 cents it rests at the edge of the scale.</summary>
    private double NeedleAngle => Math.Clamp(reading.Cents, -55, 55) * DegreesPerCent;

    private static (double X, double Y) Point(double cents, double radius)
    {
        var angle = cents * DegreesPerCent * Math.PI / 180;

        return (Cx + radius * Math.Sin(angle), Cy - radius * Math.Cos(angle));
    }

    private static string Arc(double fromCents, double toCents)
    {
        var (x1, y1) = Point(fromCents, R);
        var (x2, y2) = Point(toCents, R);

        return $"M {F(x1)} {F(y1)} A {F(R)} {F(R)} 0 0 1 {F(x2)} {F(y2)}";
    }

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        disposed = true;
        Listener.ReadingChanged -= OnReading;
        Listener.Stop();
        timer?.Dispose();
        if (window != null)
        {
            window.Stopped -= OnAppStopped;
            window.Resumed -= OnAppResumed;
        }
    }
}
