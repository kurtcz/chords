@* Line icon drawn in the current text colour; Name picks the drawing. *@
<svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true"
     fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "chord":
            @* Chord diagram: three strings, a thick nut, a fret and two fingers *@
            <path d="M5 4h14" stroke-width="2.6" />
            <path d="M5 4v17M12 4v17M19 4v17M5 12.5h14" />
            <circle cx="12" cy="8.2" r="2.3" fill="currentColor" stroke="none" />
            <circle cx="19" cy="16.8" r="2.3" fill="currentColor" stroke="none" />
            break;
        case "search":
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="M15.5 15.5L21 21" />
            break;
        case "tap":
            @* A fingertip pressing: dot with a ring around it *@
            <circle cx="12" cy="12" r="3.2" fill="currentColor" />
            <circle cx="12" cy="12" r="7.5" />
            <path d="M12 1.5v2M12 20.5v2M1.5 12h2M20.5 12h2" />
            break;
        case "star":
            <path d="M12 2.8l2.85 5.9 6.45.85-4.7 4.5 1.2 6.4L12 17.35 6.2 20.45l1.2-6.4-4.7-4.5 6.45-.85z" />
            break;
        case "theory":
            @* Two beamed eighth notes *@
            <path d="M9 18V5l11-2v13" />
            <circle cx="6" cy="18" r="3" />
            <circle cx="17" cy="16" r="3" />
            break;
        case "scale":
            @* Staff with ascending notes *@
            <path d="M3 6h18M3 10h18M3 14h18M3 18h18" stroke-width="1" />
            <ellipse cx="7" cy="16" rx="2.2" ry="1.7" fill="currentColor" stroke="none" />
            <ellipse cx="12" cy="12" rx="2.2" ry="1.7" fill="currentColor" stroke="none" />
            <ellipse cx="17" cy="8" rx="2.2" ry="1.7" fill="currentColor" stroke="none" />
            break;
        case "circle":
            <circle cx="12" cy="12" r="9" />
            <circle cx="12" cy="12" r="4" />
            <path d="M12 3v5M12 16v5M3 12h5M16 12h5M5.6 5.6l3.6 3.6M14.8 14.8l3.6 3.6M18.4 5.6l-3.6 3.6M9.2 14.8l-3.6 3.6" />
            break;
        case "progression":
            @* Chord after chord *@
            <rect x="2" y="8" width="5" height="8" rx="1" />
            <rect x="9.5" y="8" width="5" height="8" rx="1" />
            <rect x="17" y="8" width="5" height="8" rx="1" />
            <path d="M7 12h2.5M14.5 12H17" />
            break;
        case "tuner":
            @* Gauge with a needle *@
            <path d="M3.5 17a8.5 8.5 0 0 1 17 0" />
            <path d="M12 8.5v1.5M6 11l1 1M18 11l-1 1" />
            <path d="M12 17l4-5" />
            <circle cx="12" cy="17" r="1.4" fill="currentColor" />
            break;
        case "settings":
            @* Sliders *@
            <path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1" />
            <circle cx="15" cy="6" r="2" />
            <circle cx="9" cy="12" r="2" />
            <circle cx="17" cy="18" r="2" />
            break;
        case "more":
            <circle cx="5" cy="12" r="1.8" fill="currentColor" stroke="none" />
            <circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none" />
            <circle cx="19" cy="12" r="1.8" fill="currentColor" stroke="none" />
            break;
        case "chevron":
            <path d="M9 5l7 7-7 7" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; }
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string Class { get; set; }
}
