@using Microsoft.JSInterop
@implements IDisposable
@inject ChordPlayer Player
@inject AppState State
@inject IJSRuntime JS

@* Tap plays the chord, tap and hold toggles it as a favourite, a finger across the strings strums them (js/strum.js). *@
<div @ref="root" class="chord-layout @(favorite ? "favorite" : null) @(State.Settings.Horizontal ? "horizontal" : null)"
     @onpointerdown="PointerDown" @onpointerup="CancelHold" @onpointercancel="CancelHold" @onpointerleave="CancelHold"
     @onclick="Click" @oncontextmenu:preventDefault="true">
    @Layout.RenderSchema(State.Settings.Horizontal, State.Settings.Horizontal && State.Settings.LeftHanded)
    @{ var level = Layout.Layout.DifficultyLevel; }
    <div class="difficulty difficulty-@level.ToString().ToLowerInvariant()">@L[$"Difficulty_{level}"]</div>
    @* A fingering whose lowest note is not the root sounds as an inversion: it is named as the slash chord it is. *@
    @if (Layout.Layout.OtherBass)
    {
        <div class="inversion" title="@L["Layout_Inversion"]">@Layout.SlashSymbol</div>
    }
</div>

@code {
    private const int HoldMilliseconds = 400;

    [Parameter, EditorRequired] public GuitarChordLayoutDecorator Layout { get; set; }
    [Parameter, EditorRequired] public Chord Chord { get; set; }

    private bool favorite;
    private bool held;
    private CancellationTokenSource holdCts;
    private ElementReference root;
    private DotNetObjectReference<ChordLayoutView> self;

    protected override void OnParametersSet() => favorite = Layout.Favorite;

    private async Task PointerDown()
    {
        CancelHold();
        held = false;
        var cts = holdCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(HoldMilliseconds, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        held = true;
        favorite = Favorites.Toggle(Chord, Layout.Layout);
        try
        {
            HapticFeedback.Default.Perform(HapticFeedbackType.LongPress);
        }
        catch
        {
            // Haptics are optional.
        }
    }

    private void CancelHold()
    {
        holdCts?.Cancel();
        holdCts = null;
    }

    private void Click()
    {
        if (held)
        {
            held = false;
            return;
        }
        Player.PlayLayout(Layout.Layout.InstrumentInfo, Layout.IntPositions);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            self = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("chordStrum.attach", root, self);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    /// <summary>A finger started strumming: it is not holding the diagram.</summary>
    [JSInvokable]
    public void StrumStart() => CancelHold();

    /// <summary>A finger strumming the diagram crossed a string (0 = the lowest).</summary>
    [JSInvokable]
    public void Pluck(int stringIndex)
    {
        var positions = Layout.IntPositions;

        if (stringIndex < 0 || stringIndex >= positions.Length || positions[stringIndex] < 0)
        {
            return;
        }
        Player.PlayString(Layout.Layout.InstrumentInfo, positions, stringIndex);
        try
        {
            HapticFeedback.Default.Perform(HapticFeedbackType.Click);
        }
        catch
        {
            // Haptics are optional.
        }
    }

    public void Dispose()
    {
        CancelHold();
        self?.Dispose();
    }
}
