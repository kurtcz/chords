<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 7.0. Google Play requires targetSdk 36 (set by net10.0-android), not a particular minSdk. -->
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Chords.Android</RootNamespace>
    <AssemblyName>Chords.Android</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <ApplicationId>com.tnemec.chords.android</ApplicationId>
    <ApplicationTitle>Guitar Chords</ApplicationTitle>
    <!-- versionCode must be higher than the last one uploaded to Play (was 10). -->
    <ApplicationVersion>11</ApplicationVersion>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>

    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <!-- Generated Razor views and old code produce many style warnings; keep the build log readable. -->
    <NoWarn>$(NoWarn);CS0618;CS0672;CA1416;CA1422;XA4218</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Google Play only accepts Android App Bundles. -->
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
  </PropertyGroup>

  <ItemGroup>
    <!-- Old Xamarin leftovers that must not be compiled. -->
    <Compile Remove="obj\**;bin\**" />
    <None Remove="packages.config" />
    <None Remove="Resources\AboutResources.txt;Assets\AboutAssets.txt" />
    <AndroidAsset Remove="Assets\.DS_Store;Assets\AboutAssets.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chords.Core\Chords.Core.csproj" />
  </ItemGroup>

</Project>
