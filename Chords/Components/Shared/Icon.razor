@* Line icon drawn in the current text colour; Name picks the drawing. *@
<svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true"
     fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "chord":
            @* Chord diagram: three strings, a thick nut, a fret and two fingers *@
            <path d="M5 4h14" stroke-width="2.6" />
            <path d="M5 4v17M12 4v17M19 4v17M5 12.5h14" />
            <circle cx="12" cy="8.2" r="2.3" fill="currentColor" stroke="none" />
            <circle cx="19" cy="16.8" r="2.3" fill="currentColor" stroke="none" />
            break;
        case "search":
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="M15.5 15.5L21 21" />
            break;
        case "tap":
            @* A fingertip pressing: dot with a ring around it *@
            <circle cx="12" cy="12" r="3.2" fill="currentColor" />
            <circle cx="12" cy="12" r="7.5" />
            <path d="M12 1.5v2M12 20.5v2M1.5 12h2M20.5 12h2" />
            break;
        case "star":
            <path d="M12 2.8l2.85 5.9 6.45.85-4.7 4.5 1.2 6.4L12 17.35 6.2 20.45l1.2-6.4-4.7-4.5 6.45-.85z" />
            break;
        case "forum":
            @* Speech bubble *@
            <path d="M4 5.5h16v10H10l-4.5 4v-4H4z" />
            <path d="M8 9.5h8M8 12.5h5" />
            break;
        case "mail":
            @* Envelope *@
            <rect x="3" y="5.5" width="18" height="13" rx="1.5" />
            <path d="M3.5 6.5l8.5 6.5 8.5-6.5" />
            break;
        case "theory":
            @* Two beamed eighth notes *@
            <path d="M9 18V5l11-2v13" />
            <circle cx="6" cy="18" r="3" />
            <circle cx="17" cy="16" r="3" />
            break;
        case "scale":
            @* Staff with ascending notes *@
            <path d="M3 6h18M3 10h18M3 14h18M3 18h18" stroke-width="1" />
            <ellipse cx="7" cy="16" rx="2.2" ry="1.7" fill="currentColor" stroke="none" />
            <ellipse cx="12" cy="12" rx="2.2" ry="1.7" fill="currentColor" stroke="none" />
            <ellipse cx="17" cy="8" rx="2.2" ry="1.7" fill="currentColor" stroke="none" />
            break;
        case "circle":
            <circle cx="12" cy="12" r="9" />
            <circle cx="12" cy="12" r="4" />
            <path d="M12 3v5M12 16v5M3 12h5M16 12h5M5.6 5.6l3.6 3.6M14.8 14.8l3.6 3.6M18.4 5.6l-3.6 3.6M9.2 14.8l-3.6 3.6" />
            break;
        case "progression":
            @* Chord after chord *@
            <rect x="2" y="8" width="5" height="8" rx="1" />
            <rect x="9.5" y="8" width="5" height="8" rx="1" />
            <rect x="17" y="8" width="5" height="8" rx="1" />
            <path d="M7 12h2.5M14.5 12H17" />
            break;
        case "tuner":
            @* Gauge with a needle *@
            <path d="M3.5 17a8.5 8.5 0 0 1 17 0" />
            <path d="M12 8.5v1.5M6 11l1 1M18 11l-1 1" />
            <path d="M12 17l4-5" />
            <circle cx="12" cy="17" r="1.4" fill="currentColor" />
            break;
        case "metronome":
            @* Metronome: the case with its pendulum swung aside *@
            <path d="M9.2 3h5.6l4.7 18h-15z" />
            <path d="M6.6 16.5h10.8" />
            <path d="M12 16.5L17 5.5" />
            <circle cx="15.2" cy="9.4" r="1.5" fill="currentColor" />
            break;
        case "settings":
            @* Sliders *@
            <path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1" />
            <circle cx="15" cy="6" r="2" />
            <circle cx="9" cy="12" r="2" />
            <circle cx="17" cy="18" r="2" />
            break;
        case "more":
            <circle cx="5" cy="12" r="1.8" fill="currentColor" stroke="none" />
            <circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none" />
            <circle cx="19" cy="12" r="1.8" fill="currentColor" stroke="none" />
            break;
        case "chevron":
            <path d="M9 5l7 7-7 7" />
            break;
        @* Instruments: drawn upright (head at the top), then leant 45° to the right like a guitar on a stand. *@
        case "guitar":
            <g transform="rotate(45 12 12)" stroke-width="1.5">
                <rect x="10.6" y="-3" width="2.8" height="4" rx="0.8" />
                <path d="M12 1v9.4" />
                <path d="M9.25 16.32A3.6 3.6 0 1 1 14.75 16.32A5 5 0 1 1 9.25 16.32Z" />
                <circle cx="12" cy="19" r="1.3" />
            </g>
            break;
        case "ukulele":
            @* A small guitar: short neck, little body *@
            <g transform="rotate(45 12 12)" stroke-width="1.5">
                <rect x="10.7" y="0.5" width="2.6" height="3.5" rx="0.8" />
                <path d="M12 4v8.7" />
                <path d="M9.89 17.34A2.8 2.8 0 1 1 14.11 17.34A3.8 3.8 0 1 1 9.89 17.34Z" />
                <circle cx="12" cy="19.7" r="1" />
            </g>
            break;
        case "mandolin":
            @* Pear-shaped body *@
            <g transform="rotate(45 12 12)" stroke-width="1.5">
                <rect x="10.4" y="-3" width="3.2" height="3.5" rx="1" />
                <path d="M12 0.5V11" />
                <path d="M12 11C16.5 13 17.5 25 12 25C6.5 25 7.5 13 12 11Z" />
                <circle cx="12" cy="18.5" r="1.2" />
            </g>
            break;
        case "bassguitar":
            @* Long neck and pickups instead of a sound hole *@
            <g transform="rotate(45 12 12)" stroke-width="1.5">
                <rect x="10.6" y="-3.5" width="2.8" height="3.5" rx="0.8" />
                <path d="M12 0v11.6" />
                <path d="M9.54 17.35A3.4 3.4 0 1 1 14.46 17.35A4.4 4.4 0 1 1 9.54 17.35Z" />
                <path d="M10 19.5h4M10 22h4" />
            </g>
            break;
        case "banjo":
            @* Round drum body *@
            <g transform="rotate(45 12 12)" stroke-width="1.5">
                <rect x="10.6" y="-3" width="2.8" height="3.5" rx="0.8" />
                <path d="M12 0.5v13" />
                <circle cx="12" cy="19" r="5.5" />
                <circle cx="12" cy="19" r="3.8" stroke-width="1" />
            </g>
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; }
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string Class { get; set; }
}
