@page "/about"

<TopNav Title="@L["Nav_About"]" />

<div class="about">
    <AppLogo Size="112" Tile="true" Class="about-icon" />
    <div class="about-name">@Microsoft.Maui.ApplicationModel.AppInfo.Current.Name</div>
    <div class="about-version">@L["About_Version"] @Microsoft.Maui.ApplicationModel.AppInfo.Current.VersionString</div>

    <div class="settings-card about-card">
        @* Opens the app's store page, where the user can rate it (external links open outside the app). *@
        <a class="about-row" href="@StoreUrl">
            <Icon Name="star" />
            <span class="setting-label">@L["About_Rate"]</span>
        </a>
        <a class="about-row" href="@ForumUrl">
            <Icon Name="forum" />
            <span class="setting-label">@L["About_Forum"]</span>
        </a>
        @* Opens the mail app with the address, and the version in the subject. *@
        <a class="about-row" href="@MailUrl">
            <Icon Name="mail" />
            <span class="setting-label">@L["About_Email"]</span>
        </a>
    </div>

    <div class="about-credits">
        <div>&copy; 2026 Tomáš&nbsp;Němec</div>
        @* Attribution the sound font's licence (CC BY 4.0) asks for: creator, link to the material, licence, changes. *@
        <div class="about-sound">
            <div>@L["About_SoundCredit"]: <a href="@SoundFontUrl">@L["About_SoundFont"]</a> &copy; @SoundFontAuthor</div>
            <div>@L["About_License"]: <a href="@LicenseUrl">CC BY 4.0</a></div>
            @* The mandolin's sound font, in the public domain (credited though not required). *@
            <div>@L["Instrument_Mandolin"]: <a href="@MandolinUrl">Mandolino</a> @L["About_By", MandolinAuthor]</div>
            <div>@L["About_License"]: @L["About_PublicDomain"]</div>
            <div>@L["About_SoundChanges"]</div>
        </div>
    </div>
</div>

@code {
    /// <summary>The app's page in Google Play.</summary>
    private const string PlayStoreUrl = "https://play.google.com/store/apps/details?id=com.tnemec.chords.android";
    /// <summary>The app's page in the App Store (app id 6832216331), opening the review sheet.</summary>
    private const string AppStoreUrl = "https://apps.apple.com/app/id6832216331?action=write-review";
    /// <summary>The store page of the current platform.</summary>
    private static string StoreUrl => OperatingSystem.IsIOS() ? AppStoreUrl : PlayStoreUrl;

    /// <summary>The support forum, also the support URL in both stores.</summary>
    private const string ForumUrl = "https://chordexpert.freeforums.net/";
    /// <summary>The contact address, also listed in both stores and in PRIVACY.md.</summary>
    private const string Email = "chordexpert.app@gmail.com";
    private static string MailUrl => "mailto:" + Email + "?subject=" + Uri.EscapeDataString(
        $"{Microsoft.Maui.ApplicationModel.AppInfo.Current.Name} {Microsoft.Maui.ApplicationModel.AppInfo.Current.VersionString}");

    /// <summary>The sound font the other instruments' samples (Platforms/*/Resources) were made from.</summary>
    private const string SoundFontUrl = "https://musical-artifacts.com/artifacts/738";
    private const string SoundFontAuthor = "Frank\u00a0Wen";
    private const string LicenseUrl = "https://creativecommons.org/licenses/by/4.0/deed.en";
    /// <summary>The mandolin's sound font (Mandolino.sf2, preset Mandolino2).</summary>
    private const string MandolinUrl = "https://www.polyphone.io/en/soundfonts/plucked-strings/633-mandolino";
    private const string MandolinAuthor = "bottrop";
}
