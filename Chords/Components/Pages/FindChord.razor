@page "/find"
@using System.Text.RegularExpressions
@inject AppState State
@inject NavigationManager Nav

<TopNav Title="@L["Nav_FindChord"]" />

<div class="page-segment">
    <Segmented Value="State.StrictFind" ValueChanged="v => State.StrictFind = v" Off="@L["Find_Loose"]" On="@L["Find_Strict"]" />
    @* What the mode means: C♯ and D♭ the same note or not. *@
    <p class="page-segment-hint">@(model.Notes[0].ToString(conv))<sub>#</sub> @(State.StrictFind ? "≠" : "=") @(model.Notes[3].ToString(conv))<sub>b</sub></p>
</div>
<div class="note-grid">
    @foreach (var row in notes.Chunk(5))
    {
        <div class="note-row">
            @foreach (var (html, value) in row)
            {
                <Toggle Value="State.FindNotes.Contains(value)" ValueChanged="on => SetNote(value, on)" Width="auto"
                        On="@(b => b.AddMarkupContent(0, html.Value))" Off="@(b => b.AddMarkupContent(0, html.Value))" />
            }
        </div>
    }
</div>
<button type="button" class="btn btn-primary btn-lg btn-block page-action" @onclick="Find">@L["Find"]</button>
<div class="error">@error</div>

<RelatedLinks Pages="[AppPages.FindShape, AppPages.ShowChord]" />

@code {
    private readonly FindChordModel model = new();
    private NamingConvention conv;
    private (MarkupString Html, string Value)[] notes;
    private string error;

    protected override void OnInitialized()
    {
        conv = State.Settings.conv;
        notes = model.AllNotes[conv]
            .Select(html => (html, Regex.Replace(html.Value, "<.*?>", string.Empty)))
            .ToArray();
        if (State.FindNotesConvention != conv)
        {
            State.FindNotes.Clear();
            State.FindNotesConvention = conv;
        }
    }

    private void SetNote(string value, bool on)
    {
        error = null;
        if (on)
        {
            State.FindNotes.Add(value);
        }
        else
        {
            State.FindNotes.Remove(value);
        }
    }

    private void Find()
    {
        error = null;
        var selected = State.FindNotes
            .Select(i => Note.TryParse(i, conv, out var note) ? note : null)
            .Where(i => i != null)
            .ToArray();

        if (selected.Length == 0)
        {
            return;
        }
        var chords = Chord.Find(selected, State.StrictFind);

        if (chords.Length == 0)
        {
            error = L["Find_NoChord"];
            return;
        }
        var chord = chords[0];
        string roots = null, types = null;

        if (chords.Length > 1)
        {
            roots = string.Join(",", chords.Select(i => i.Root.ToString()));
            types = string.Join(",", chords.Select(i => i.ChordType.ToDescription()));
        }
        Nav.NavigateTo(ChordPage.Url(chord.Root, chord.ChordType.ToDescription(), true, roots, types));
    }
}
