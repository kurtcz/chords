@page "/chord"
@inject AppState State

<TopNav Title="@L["Nav_ShowChord"]" />

@if (allRoots.Length > 1)
{
    <h4 class="other-chords">
        @L["Chord_Found"]
        @for (var i = 0; i < allRoots.Length && i < allTypes.Length; i++)
        {
            var other = allRoots[i];
            var otherType = allTypes[i];
            Note otherBass = null;
            @if (Note.TryParse(other, NamingConvention.English, out var otherRoot) &&
                 (i >= allBasses.Length || allBasses[i].Length == 0 || Note.TryParse(allBasses[i], NamingConvention.English, out otherBass)))
            {
                <a href="@Url(otherRoot, otherType, Partial, Roots, Types, otherBass, Basses)">@otherRoot.ToString(conv)@otherType@(otherBass == null ? null : "/" + otherBass.ToString(conv))</a>
                @(" ")
            }
        }
    </h4>
}
@if (decorator != null)
{
    <h2>@decorator.Symbols[0]</h2>
    @* With a capo the diagrams show the shape to hold, which has a name of its own. *@
    @if (State.Settings.Capo > 0)
    {
        <p class="capo-shape">@L["Capo_Shape", State.Settings.Capo, new ChordDecorator(chord.Transpose(-State.Settings.Capo), conv).Symbols[0]]</p>
    }

    @if (decorator.Symbols.Length > 1)
    {
        <h4>@L["Chord_OtherSymbols"]</h4>
        @foreach (var otherSymbol in decorator.Symbols.Skip(1))
        {
            <span>@otherSymbol </span>
        }
    }
    <h4>@L["Chord_Intervals"]</h4>
    <p>
        @foreach (var interval in decorator.Intervals)
        {
            <span>@interval </span>
        }
    </p>
    <h4>@L["Chord_Notes"]</h4>
    <p>
        @foreach (var note in decorator.Notes)
        {
            <span>@note </span>
        }
    </p>
}
<div class="error">@error</div>
@if (decorator != null && layouts == null)
{
    <div id="loader"></div>
}
@if (layouts != null)
{
    <div id="layouts" class="animate-bottom">
        <h4>@L["Chord_Diagrams"]</h4>
        <p>@L.Plural("Chord_Results", layouts.Length) &ndash; @L[$"Instrument_{State.Settings.Instrument}"] <TuningBadge /></p>
        @if (State.Settings.ShowTips && !tipClosed)
        {
            <div class="alert alert-info">
                <button type="button" class="close" @onclick="() => tipClosed = true">&times;</button>
                <strong>@L["Tip"]</strong> @L["Tip_Play"]<br />
                @L[State.Settings.Horizontal ? "Tip_StrumPick" : "Tip_Strum"]<br />
                @L["Tip_Favorite"]
            </div>
        }
        <div class="chord-grid">
            @foreach (var layout in layouts)
            {
                <ChordLayoutView @key="layout" Layout="layout" Chord="chord" />
            }
        </div>
    </div>
}

@if (layouts != null)
{
    <FretboardView Notes="chord.Notes" Intervals="chord.Intervals" Hint="@L["Fretboard_ChordHint", decorator.Symbols[0]]" />
    <RelatedLinks Pages="[AppPages.Favorites, AppPages.FindChord, AppPages.FindShape]" />
}

@code {
    [SupplyParameterFromQuery(Name = "root")] public string Root { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string Type { get; set; }
    [SupplyParameterFromQuery(Name = "partial")] public bool Partial { get; set; }
    [SupplyParameterFromQuery(Name = "roots")] public string Roots { get; set; }
    [SupplyParameterFromQuery(Name = "types")] public string Types { get; set; }
    /// <summary>Bass of a slash chord (D/F♯), empty for root position.</summary>
    [SupplyParameterFromQuery(Name = "bass")] public string Bass { get; set; }
    /// <summary>Only fingerings with the root lowest (no inversions); without it and without a bass any bass goes.</summary>
    [SupplyParameterFromQuery(Name = "rootbass")] public bool RootBass { get; set; }
    /// <summary>Basses of the chords listed in <see cref="Roots"/>, empty for root position.</summary>
    [SupplyParameterFromQuery(Name = "basses")] public string Basses { get; set; }

    private NamingConvention conv;
    private Chord chord;
    private ChordDecorator decorator;
    private GuitarChordLayoutDecorator[] layouts;
    private string error;
    private bool tipClosed;
    private string[] allRoots = [];
    private string[] allTypes = [];
    private string[] allBasses = [];

    /// <summary>Chord roots, types and basses are passed in English naming convention.</summary>
    /// <param name="rootBass">Only fingerings with the root lowest (ignored for a slash chord).</param>
    public static string Url(Note root, string type, bool partial, string roots = null, string types = null, Note bass = null, string basses = null, bool rootBass = false)
    {
        var url = $"chord?root={Uri.EscapeDataString(root.ToString())}&type={Uri.EscapeDataString(type ?? string.Empty)}&partial={partial}";

        if (bass != null)
        {
            url += $"&bass={Uri.EscapeDataString(bass.ToString())}";
        }
        else if (rootBass)
        {
            url += "&rootbass=true";
        }
        if (!string.IsNullOrEmpty(roots))
        {
            url += $"&roots={Uri.EscapeDataString(roots)}&types={Uri.EscapeDataString(types ?? string.Empty)}";
            if (!string.IsNullOrEmpty(basses?.Replace(",", "")))
            {
                url += $"&basses={Uri.EscapeDataString(basses)}";
            }
        }

        return url;
    }

    /// <summary>Page of a chord (with its bass when it is a slash chord), listing the other chords found with it.</summary>
    public static string Url(Chord chord, bool partial, IReadOnlyList<Chord> found = null)
    {
        string roots = null, types = null, basses = null;

        if (found != null && found.Count > 1)
        {
            roots = string.Join(",", found.Select(i => i.Root.ToString()));
            types = string.Join(",", found.Select(i => i.ChordType.ToDescription()));
            basses = string.Join(",", found.Select(i => i.Bass?.ToString() ?? string.Empty));
        }

        return Url(chord.Root, chord.ChordType.ToDescription(), partial, roots, types, chord.Bass, basses);
    }

    protected override async Task OnParametersSetAsync()
    {
        var settings = State.Settings;
        var id = $"{Root}{Type}";

        conv = settings.conv;
        allRoots = Roots?.Split(',') ?? [];
        allTypes = Types?.Split(',') ?? [];
        allBasses = Basses?.Split(',') ?? [];
        decorator = null;
        layouts = null;
        error = null;

        Note bass = null;
        if (!Chord.TryParse(id, NamingConvention.English, out chord) ||
            (!string.IsNullOrEmpty(Bass) && !Note.TryParse(Bass, NamingConvention.English, out bass)))
        {
            error = L["Chord_Invalid", string.IsNullOrEmpty(Bass) ? id : $"{id}/{Bass}"];
            return;
        }
        chord = chord.WithBass(bass);
        State.CurrentRoot = chord.Root;
        State.CurrentChordType = chord.ChordType;
        State.CurrentBass = chord.Bass;
        State.CurrentRootBass = chord.Bass == null && RootBass;
        decorator = new ChordDecorator(chord, conv);

        var current = decorator;
        var result = await Task.Run(() => current
            .GenerateLayouts(settings.InstrumentInfo, settings.AllowBarre, settings.AllowSpecial, Partial, settings.maxFret, settings.EasyOnly,
                             chord.Bass == null && RootBass)
            .OrderBy(i => i.Favorite ? 0 : 1)
            .ToArray());

        if (current == decorator)
        {
            layouts = result;
        }
    }
}
