@page "/tuner"
@using System.Globalization
@using Chords.Core.Tuning
@using Microsoft.JSInterop
@implements IDisposable
@inject AppState State
@inject TunerListener Listener
@inject ChordPlayer Player
@inject IJSRuntime JS

<TopNav Title="@L["Nav_Tuner"]" />

@if (status == TunerStatus.Denied)
{
    <div class="alert alert-warning">
        <p>@L["Tuner_MicDenied"]</p>
        <button type="button" class="btn btn-default" @onclick="() => AppInfo.ShowSettingsUI()">@L["Tuner_OpenSettings"]</button>
    </div>
}
else if (status == TunerStatus.Failed)
{
    <div class="alert alert-danger">@L["Tuner_MicError"]</div>
}

@* Side by side on a wide or landscape screen: the gauge, and the choices of what to tune to. *@
<div class="tuner-layout">
<div class="tuner-display @StateClass">
    @*
        Three layers of the same size: the scale, the needle and the hub. The needle has an <svg> of its own, which the
        WebView rotates as a ready-made picture; turning it inside the scale's <svg> would repaint the whole scale on
        every step, 30 times a second while a note sounds.
    *@
    <div class="tuner-dial">
    <svg class="tuner-gauge" viewBox="@ViewBox" xmlns="http://www.w3.org/2000/svg">
        @* The scale never changes: its markup is formatted once (ScalePaths and the like), not with every redraw. *@
        @foreach (var (css, d) in ScalePaths)
        {
            <path class="@css" d="@d" />
        }
        @foreach (var (css, x1, y1, x2, y2) in ScaleTicks)
        {
            <line class="@css" x1="@x1" y1="@y1" x2="@x2" y2="@y2" />
        }
        @foreach (var (css, x, y, text) in ScaleLabels)
        {
            <!text class="@css" x="@x" y="@y">@text</!text>
        }
    </svg>
    @* Always there: js/tuner.js turns it with every reading and hides it in silence, between the redraws. *@
    <svg class="tuner-needle" viewBox="@ViewBox" xmlns="http://www.w3.org/2000/svg" @ref="needle">
        <path d="@NeedlePath" />
    </svg>
    <svg class="tuner-pivot" viewBox="@ViewBox" xmlns="http://www.w3.org/2000/svg">
        <circle class="tuner-hub" cx="@HubX" cy="@HubY" r="10" />
        <circle cx="@HubX" cy="@HubY" r="3.5" fill="#fff" />
    </svg>
    </div>
    @* Below the gauge: the target note in the middle, the cents on its left and the frequency on its right. *@
    <div class="tuner-readout">
        <div class="tuner-side tuner-side-left">
            @if (reading != null)
            {
                <span class="tuner-cents">@reading.Cents.ToString("+0;−0;0", CultureInfo.InvariantCulture)¢</span>
            }
        </div>
        <div class="tuner-note">
            @if (reading == null)
            {
                <span>–</span>
            }
            else
            {
                @NoteLetter(reading.Target, reading.String)<sub>@TunerMath.OctaveOf(reading.Target)</sub>
            }
        </div>
        <div class="tuner-side tuner-side-right">
            @if (reading != null)
            {
                <span class="tuner-hz">@reading.Frequency.ToString("0.0", CultureInfo.CurrentCulture)<small> Hz</small></span>
                @if ((int)Math.Round(reading.Pitch) != reading.Target)
                {
                    <span class="tuner-heard">♪ @NoteName((int)Math.Round(reading.Pitch))</span>
                }
            }
        </div>
    </div>
    @if (Direction is { } direction)
    {
        <div class="tuner-direction @direction.Css">@direction.Text</div>
    }
</div>

<div class="tuner-controls">
<div class="tuner-mode" role="group">
    <button type="button" class="@(chromatic ? null : "active")" aria-pressed="@(!chromatic)" @onclick="() => SetChromatic(false)">
        @L[$"Instrument_{State.Settings.Instrument}"]
    </button>
    <button type="button" class="@(chromatic ? "active" : null)" aria-pressed="@chromatic" @onclick="() => SetChromatic(true)">
        @L["Tuner_Chromatic"]
    </button>
</div>

@if (!chromatic)
{
    <div class="tuner-strings">
        <button type="button" class="tuner-auto @(lockedString < 0 ? "active" : null)" @onclick="() => Lock(-1)">
            @L["Tuner_Auto"]
        </button>
        @* The strings stay on one line; when Auto does not fit beside them, it goes on a line of its own. *@
        <div class="tuner-string-row">
            @for (var s = 0; s < instrument.StringCount; s++)
            {
                var str = s;
                var css = (lockedString == s ? "locked " : "") + (reading?.String == s ? "heard " : "") + (tunedStrings.Contains(s) ? "done" : "");
                var offset = tuning.Offset(s);
                @* A string tuned away from the standard tuning shows by how many half steps, so it is retuned first. *@
                <button type="button" class="tuner-string @css @(offset != 0 ? "retuned" : null)" title="@NoteName(instrument.Pitches[s], s)" @onclick="() => Lock(str)">
                    @NoteLetter(instrument.Pitches[s], s)
                    @if (offset != 0)
                    {
                        <span class="tuner-offset">@offset.ToString("+0;−0")</span>
                    }
                </button>
            }
        </div>
    </div>

    @* Quick switch between the tunings of the instrument; the strings above follow it. Below them, so they stay in view. *@
    <div class="tuner-tuning">
        <select aria-label="@L["Tuning_Custom"]" @onchange="e => SetTuning((string)e.Value)">
            @{ var i = 0; }
            @foreach (var t in tunings)
            {
                <option value="@i" selected="@(InstrumentTuning.SamePitches(t.Pitches, instrument.Pitches))">@L.TuningName(t) (@Localizer.TuningNotes(t, conv, " "))</option>
                i++;
            }
        </select>
    </div>
}

<div class="tuner-a4">
    <div class="tuner-stepper">
        <button type="button" @onclick="() => SetA4(a4 - 1)" disabled="@(a4 <= MinA4)">−</button>
        <span>@TunerMath.NoteOf(69).ToString(conv)4 = @a4 Hz</span>
        <button type="button" @onclick="() => SetA4(a4 + 1)" disabled="@(a4 >= MaxA4)">+</button>
    </div>
</div>

@if (State.Settings.ShowTips && !tipClosed && !chromatic)
{
    <div class="alert alert-info tuner-tip">
        <button type="button" class="close" @onclick="() => tipClosed = true">&times;</button>
        @L["Tuner_Hint"]
    </div>
}
</div>
</div>

@code {
    private const int MinA4 = 430;
    private const int MaxA4 = 450;
    /// <summary>Green zone of the gauge.</summary>
    private const double InTuneCents = 5;
    /// <summary>The string counts as tuned when it stays in the green zone for <see cref="SettleTime"/>.</summary>
    private const double TunedCents = InTuneCents;
    private static readonly TimeSpan SettleTime = TimeSpan.FromSeconds(0.8);
    /// <summary>
    /// Redraws of the note, cents and colours, and needle targets sent to the page, per second at most;
    /// the needle's spring smooths its motion in between.
    /// </summary>
    private const int FrameRate = 30;
    /// <summary>A change of the cents or hertz alone is redrawn at every this many redraws (10 a second).</summary>
    private const int NumbersEvery = 3;
    private const double Cx = 150, Cy = 160;
    /// <summary>The part of the drawing the gauge shows; the needle turns around (Cx, Cy), see .tuner-needle in style.css.</summary>
    private const string ViewBox = "0 22 300 152";
    /// <summary>Radius of the coloured scale.</summary>
    private const double R = 130;
    /// <summary>Cents left blank between two zones of the scale.</summary>
    private const double ZoneGap = 0.6;
    /// <summary>Zones of the scale, mirrored around 0 cents: from, to (cents) and CSS class.</summary>
    private static readonly (double From, double To, string Css)[] Zones =
    {
        (0, InTuneCents, "zone in-tune"),
        (InTuneCents, 12, "zone near"),
        (12, 25, "zone off"),
        (25, 55, "zone far"),
    };
    /// <summary>Degrees the needle turns per cent (±50 cents = ±60°).</summary>
    private const double DegreesPerCent = 1.2;
    /// <summary>The screen stays on this long after the last note heard; then the system may dim it again.</summary>
    private static readonly TimeSpan KeepAwakeFor = TimeSpan.FromSeconds(30);
    /// <summary>Coloured zones of the scale: CSS class and path.</summary>
    private static readonly (string Css, string D)[] ScalePaths = Zones.SelectMany(z => z.From == 0
        ? new[] { (z.Css, Arc(-z.To + ZoneGap, z.To - ZoneGap)) }
        : new[] { (z.Css, Arc(-z.To, -z.From - ZoneGap)), (z.Css, Arc(z.From + ZoneGap, z.To)) }).ToArray();
    /// <summary>Ticks every 5 cents: CSS class and end points.</summary>
    private static readonly (string Css, string X1, string Y1, string X2, string Y2)[] ScaleTicks = Enumerable.Range(-10, 21).Select(i =>
    {
        var c = i * 5;
        var major = c % 25 == 0;
        var (x1, y1) = Point(c, R - (major ? 24 : 17));
        var (x2, y2) = Point(c, R - 9);

        return (c == 0 ? "tick center" : major ? "tick major" : "tick", F(x1), F(y1), F(x2), F(y2));
    }).ToArray();
    /// <summary>Cent numbers and the flat and sharp signs: CSS class, position and text.</summary>
    private static readonly (string Css, string X, string Y, string Text)[] ScaleLabels =
    {
        Label("tuner-label", -50, R - 35, 0, 5, "−50"),
        Label("tuner-label", -25, R - 35, 0, 5, "−25"),
        Label("tuner-label", 25, R - 35, 0, 5, "+25"),
        Label("tuner-label", 50, R - 35, 0, 5, "+50"),
        // The flat's ink stands on the baseline and reaches higher than the sharp's, which hangs below it; lower it to match.
        Label("tuner-accidental flat", -62, R - 4, -4, 24, "♭"),
        Label("tuner-accidental", 62, R - 4, 4, 20, "♯"),
    };
    private static readonly string NeedlePath =
        $"M {F(Cx - 4)} {F(Cy)} L {F(Cx - 1)} {F(Cy - R + 6)} Q {F(Cx)} {F(Cy - R + 3)} {F(Cx + 1)} {F(Cy - R + 6)} L {F(Cx + 4)} {F(Cy)} Z";
    private static readonly string HubX = F(Cx), HubY = F(Cy);

    private InstrumentInfo instrument;
    private InstrumentTuning tuning;
    private InstrumentTuning[] tunings = [];
    private NamingConvention conv;
    private int a4;
    private int lockedString = -1;
    /// <summary>Tunes to the nearest semitone instead of the strings of the instrument.</summary>
    private bool chromatic;
    private TunerStatus status;
    private TunerReading reading;
    /// <summary>What the last redraw showed, see <see cref="Shown"/>.</summary>
    private (string, string, int, int, int, int, int, int) lastShown;
    /// <summary>Redraws since the cents or hertz were last brought up to date, see <see cref="NumbersEvery"/>.</summary>
    private int numbersSkipped;
    private volatile TunerReading latest;
    private volatile bool dirty;
    private DateTime? inTuneSince;
    private bool tuned;
    /// <summary>Strings tuned since the page was opened.</summary>
    private readonly HashSet<int> tunedStrings = new();
    private bool tipClosed;
    private Timer timer;
    private ElementReference needle;
    private bool rendered;
    /// <summary>The needle angle last sent to the page (null = hidden).</summary>
    private double? needleShown;
    /// <summary>Whether the page has been told anything about the needle yet.</summary>
    private bool needleSent;
    private Window window;
    private bool disposed;
    /// <summary>UTC ticks of the last note heard (0 = none yet).</summary>
    private long lastNoteTicks;
    /// <summary>Whether the screen is kept on; touched on the main thread only.</summary>
    private bool keepingAwake;

    protected override async Task OnInitializedAsync()
    {
        instrument = State.Settings.InstrumentInfo.Uncapoed;
        tuning = State.Settings.TuningOf(State.Settings.Instrument);
        tunings = State.Settings.TuningsFor(State.Settings.Instrument).ToArray();
        if (!tunings.Any(t => InstrumentTuning.SamePitches(t.Pitches, tuning.Pitches)))
        {
            tunings = [tuning, .. tunings];
        }
        conv = State.Settings.conv;
        a4 = Math.Clamp(State.Settings.TunerA4, MinA4, MaxA4);
        chromatic = State.Settings.TunerChromatic;
        Listener.ReadingChanged += OnReading;
        timer = new Timer(_ => Redraw(), null, 1000 / FrameRate, 1000 / FrameRate);
        window = Application.Current?.Windows.FirstOrDefault();
        if (window != null)
        {
            // Release the microphone while the app is in the background.
            window.Stopped += OnAppStopped;
            window.Resumed += OnAppResumed;
        }
        await StartAsync();
    }

    private async Task StartAsync()
    {
        status = await Listener.StartAsync(instrument, a4, lockedString, chromatic);
        if (disposed)
        {
            Listener.Stop();
        }
    }

    private void OnAppStopped(object sender, EventArgs e)
    {
        Listener.Stop();
        Interlocked.Exchange(ref lastNoteTicks, 0);
        MainThread.BeginInvokeOnMainThread(() => KeepAwake(false));
    }

    private void OnAppResumed(object sender, EventArgs e) => InvokeAsync(async () =>
    {
        if (!disposed)
        {
            // Also picks up a microphone permission granted in the system settings meanwhile.
            await StartAsync();
            StateHasChanged();
        }
    });

    protected override void OnAfterRender(bool firstRender)
    {
        rendered = true;
        // Any render, also one after a tap, is what is on screen now.
        lastShown = Shown();
    }

    private void OnReading(TunerReading value)
    {
        latest = value;
        dirty = true;
        if (value != null)
        {
            Interlocked.Exchange(ref lastNoteTicks, DateTime.UtcNow.Ticks);
        }
    }

    /// <summary>
    /// Sends the needle's new angle to the page; a change too small to see is not sent, each call crosses the
    /// WebView bridge.
    /// </summary>
    private async Task MoveNeedle(TunerReading value)
    {
        if (disposed || !rendered)
        {
            return;
        }
        var angle = value == null ? null : NeedleAngle(value);

        if (needleSent && (angle == null
                ? needleShown == null
                : needleShown != null && Math.Abs(angle.Value - needleShown.Value) < 0.1))
        {
            return;
        }
        needleSent = true;
        needleShown = angle;
        try
        {
            await JS.InvokeVoidAsync("tunerNeedle.target", needle, angle);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void Redraw()
    {
        UpdateKeepAwake();
        if (!dirty)
        {
            return;
        }
        dirty = false;
        InvokeAsync(() =>
        {
            reading = latest;
            _ = MoveNeedle(reading);
            UpdateTuned();
            // Readings differ in the tiniest fraction of a cent every time; redraw only when what is shown changes.
            var shown = Shown();

            if (shown == lastShown)
            {
                return;
            }
            // Cents and hertz alone change on every reading and could not be read at the full rate; they wait for
            // every NumbersEvery-th redraw, anything else (note, string, colours) shows at once.
            var numbersOnly = (shown with { Item5 = 0, Item6 = 0 }) == (lastShown with { Item5 = 0, Item6 = 0 });

            if (numbersOnly && ++numbersSkipped < NumbersEvery)
            {
                dirty = true;
                return;
            }
            numbersSkipped = 0;
            lastShown = shown;
            StateHasChanged();
        });
    }

    /// <summary>Everything a redraw shows of the current reading (the needle moves on its own).</summary>
    private (string, string, int, int, int, int, int, int) Shown() => reading == null
        ? (StateClass, Direction?.Css, 0, -1, int.MinValue, 0, 0, tunedStrings.Count)
        : (StateClass, Direction?.Css, reading.Target, reading.String, (int)Math.Round(reading.Cents),
            (int)Math.Round(reading.Frequency * 10), (int)Math.Round(reading.Pitch), tunedStrings.Count);

    /// <summary>
    /// Nobody touches the screen while tuning, so it would dim in the middle of it: keep it on while notes
    /// are heard, and let the system dim it again once the tuner has been quiet for <see cref="KeepAwakeFor"/>.
    /// </summary>
    private void UpdateKeepAwake()
    {
        var last = Interlocked.Read(ref lastNoteTicks);
        var want = !disposed && last != 0 && DateTime.UtcNow.Ticks - last < KeepAwakeFor.Ticks;

        if (want != Volatile.Read(ref keepingAwake))
        {
            MainThread.BeginInvokeOnMainThread(() => KeepAwake(want && !disposed));
        }
    }

    private void KeepAwake(bool value)
    {
        if (keepingAwake == value)
        {
            return;
        }
        keepingAwake = value;
        try
        {
            DeviceDisplay.Current.KeepScreenOn = value;
        }
        catch (Exception)
        {
            // Not supported on this platform: the screen dims as usual.
        }
    }

    private void UpdateTuned()
    {
        if (reading == null)
        {
            // The last string tuned stays ticked until the next note.
            inTuneSince = null;
            return;
        }
        if (Math.Abs(reading.Cents) <= TunedCents)
        {
            inTuneSince ??= DateTime.UtcNow;
            tuned = DateTime.UtcNow - inTuneSince >= SettleTime;
            if (tuned && reading.String >= 0)
            {
                tunedStrings.Add(reading.String);
            }
        }
        else
        {
            inTuneSince = null;
            tuned = false;
        }
    }

    private void Lock(int s)
    {
        lockedString = s;
        if (s >= 0)
        {
            Player.PlayPitch(instrument.Pitches[s], a4: a4);
        }
        Listener.Configure(instrument, a4, lockedString, chromatic);
    }

    private void SetChromatic(bool value)
    {
        if (chromatic == value)
        {
            return;
        }
        chromatic = value;
        reading = null;
        inTuneSince = null;
        tuned = false;
        State.Settings.TunerChromatic = chromatic;
        State.Settings.Save();
        Listener.Configure(instrument, a4, lockedString, chromatic);
    }

    private void SetTuning(string index)
    {
        if (!int.TryParse(index, out var i) || i < 0 || i >= tunings.Length)
        {
            return;
        }
        State.Settings.SelectTuning(State.Settings.Instrument, tunings[i].Pitches);
        State.Settings.Save();
        instrument = State.Settings.InstrumentInfo.Uncapoed;
        tuning = State.Settings.TuningOf(State.Settings.Instrument);
        // The strings now have other targets.
        tunedStrings.Clear();
        reading = null;
        inTuneSince = null;
        tuned = false;
        Listener.Configure(instrument, a4, lockedString, chromatic);
    }

    private void SetA4(int value)
    {
        a4 = Math.Clamp(value, MinA4, MaxA4);
        // Strings tuned to the old reference pitch are no longer in tune.
        tunedStrings.Clear();
        State.Settings.TunerA4 = a4;
        State.Settings.Save();
        Listener.Configure(instrument, a4, lockedString, chromatic);
    }

    private string NoteName(int pitch, int s = -1) => NoteLetter(pitch, s) + TunerMath.OctaveOf(pitch);

    /// <summary>Name of a pitch; an open string's spelled like its tuning (E♭ in the half-step-down tuning).</summary>
    private string NoteLetter(int pitch, int s = -1)
        => (s >= 0 && s < tuning.Pitches.Length && tuning.Pitches[s] == pitch ? tuning.NoteOf(s) : TunerMath.NoteOf(pitch)).ToString(conv);

    private string StateClass => reading == null ? "silent"
        : tuned ? "tuned"
        : Math.Abs(reading.Cents) <= InTuneCents ? "near"
        : null;

    /// <summary>CSS class and text of the hint below the gauge; null when there is none.</summary>
    private (string Css, string Text)? Direction => reading == null
            ? tuned ? ("ok", "✓ " + L["Tuner_InTune"])
            : status == TunerStatus.Listening ? ("idle", L[chromatic ? "Tuner_ListeningNote" : "Tuner_Listening"])
            : null
        : tuned || Math.Abs(reading.Cents) <= InTuneCents ? ("ok", "✓ " + L["Tuner_InTune"])
        : reading.Cents < 0 ? ("up", "↑ " + L["Tuner_TuneUp"])
        : ("down", "↓ " + L["Tuner_TuneDown"]);

    /// <summary>Needle angle; beyond ±50 cents it rests at the edge of the scale.</summary>
    private static double? NeedleAngle(TunerReading value) => Math.Clamp(value.Cents, -55, 55) * DegreesPerCent;

    private static (double X, double Y) Point(double cents, double radius)
    {
        var angle = cents * DegreesPerCent * Math.PI / 180;

        return (Cx + radius * Math.Sin(angle), Cy - radius * Math.Cos(angle));
    }

    private static string Arc(double fromCents, double toCents)
    {
        var (x1, y1) = Point(fromCents, R);
        var (x2, y2) = Point(toCents, R);

        return $"M {F(x1)} {F(y1)} A {F(R)} {F(R)} 0 0 1 {F(x2)} {F(y2)}";
    }

    private static (string, string, string, string) Label(string css, double cents, double radius, double dx, double dy, string text)
    {
        var (x, y) = Point(cents, radius);

        return (css, F(x + dx), F(y + dy), text);
    }

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        disposed = true;
        Listener.ReadingChanged -= OnReading;
        Listener.Stop();
        timer?.Dispose();
        MainThread.BeginInvokeOnMainThread(() => KeepAwake(false));
        if (window != null)
        {
            window.Stopped -= OnAppStopped;
            window.Resumed -= OnAppResumed;
        }
    }
}
