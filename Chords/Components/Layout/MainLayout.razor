@inherits LayoutComponentBase
@implements IDisposable
@* Creating AppState applies the language from settings before any page renders. *@
@inject AppState State
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Keyed by language: switching the language rebuilds the page so every component shows the new texts. *@
@* The theme class here colours the page at once; on <html> (set from OnAfterRenderAsync) it colours what lies outside. *@
<div class="app-root @(State.IsDark ? "theme-dark" : null)" dir="@(Localizer.IsRightToLeft ? "rtl" : "ltr")" lang="@Localizer.CurrentLanguage" @key="language">
    @* On a tablet most pages keep to a readable column; grids of chord diagrams use the whole width. *@
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 main-content @(WidePage ? "page-wide" : "page-narrow")">
        @Body
    </div>
    <TabBar />
</div>

@code {
    private string language = System.Globalization.CultureInfo.CurrentUICulture.Name;

    private bool? renderedDark;

    private (double Left, double Right)? renderedSideInsets;

    /// <summary>Pages that are mostly a grid of chord diagrams (the layout renders again with each new page).</summary>
    private bool WidePage => AppPages.FromRelativeUri(Nav.ToBaseRelativePath(Nav.Uri)) is var page
                             && (page == AppPages.ChordDetail || page == AppPages.Favorites);

    protected override void OnInitialized()
    {
        L.LanguageChanged += OnLanguageChanged;
        State.ThemeChanged += OnThemeChanged;
        SideInsets.Changed += OnSideInsetsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (renderedDark != State.IsDark)
        {
            renderedDark = State.IsDark;
            await JS.InvokeVoidAsync("chordsTheme.set", State.IsDark);
        }
        if (SideInsets.Known && renderedSideInsets != (SideInsets.Left, SideInsets.Right))
        {
            renderedSideInsets = (SideInsets.Left, SideInsets.Right);
            await JS.InvokeVoidAsync("chordsSideInsets.set", SideInsets.Left, SideInsets.Right);
        }
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnSideInsetsChanged() => InvokeAsync(StateHasChanged);

    private void OnLanguageChanged()
    {
        language = System.Globalization.CultureInfo.CurrentUICulture.Name;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
        State.ThemeChanged -= OnThemeChanged;
        SideInsets.Changed -= OnSideInsetsChanged;
    }
}
