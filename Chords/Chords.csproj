<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Chords</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>Chord Expert</ApplicationTitle>
    <!-- The Android id must stay the same so Google Play treats this as an update of the existing app. -->
    <ApplicationId>com.tnemec.chords.android</ApplicationId>
    <ApplicationId Condition="$(TargetFramework.Contains('-ios'))">com.tnemec.chords.ios</ApplicationId>
    <!-- Build number: Android versionCode and iOS CFBundleVersion. Must be higher than any build uploaded to the stores before. -->
    <ApplicationVersion>200</ApplicationVersion>
    <ApplicationDisplayVersion>2.0</ApplicationDisplayVersion>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    A Debug build would run everything on the Mono interpreter (for hot reload), and the tuner's signal processing
    (filter, FFT, pitch detection 50 times a second) is many times slower interpreted. Without it Android and the iOS
    simulator JIT-compile and an iOS device AOT-compiles, as in Release; C# hot reload is not available.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseInterpreter>false</UseInterpreter>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
    <!--
      Shrink the Java/DEX side with R8 (otherwise the build only dexes with D8). This takes the bundle's DEX from
      ~16 MB to ~9 MB, under the 10 MB size at which Google Play enforces its 25% code optimisation thresholds
      (February 2027). R8 cannot obfuscate here: the .NET Android SDK always passes -dontobfuscate
      (dotnet/android#12535), so keep the DEX under 10 MB. The mapping file is for Play's crash stack traces.
    -->
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidCreateProguardMappingFile>true</AndroidCreateProguardMappingFile>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.56" Color="#000000" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#222222" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!--
    MAUI 10 pulls in Material Components 1.12, whose dialogs call Window.setStatusBarColor/setNavigationBarColor,
    deprecated in Android 15 (Google Play warns about it). 1.14 only calls them below Android 15. MAUI 11 depends
    on 1.14 itself: remove this group then. 1.14 raises some AndroidX libraries; their Kotlin extension (Ktx)
    packages, which MAUI pins to the old versions, are raised to match.
  -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chords.Core\Chords.Core.csproj" />
  </ItemGroup>

  <Import Project="PlatformLocales.targets" />

</Project>
